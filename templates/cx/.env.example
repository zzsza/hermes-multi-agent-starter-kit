# 실제 비밀값은 프로필의 .env에만 입력합니다. 이 양식에는 넣지 않습니다.
# 채널 값은 서비스 시작 전에 반드시 실제 테스트 채널 ID로 채웁니다.
# 설치 전에 워크스페이스와 테스트 채널을 질문하고 실제 ID를 확인합니다.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=
SLACK_ALLOWED_CHANNELS=
SLACK_HOME_CHANNEL=
SLACK_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
SLACK_ALLOW_BOTS=mentions
SLACK_REQUIRE_MENTION=true
SLACK_STRICT_MENTION=true
# 사람이 직접 요청한 CX 업무의 조율 보고 대상, 실제 A Member ID를 설정합니다.
MAIN_AGENT_USER_ID=
